# ===== SENDGRID CONFIGURATION =====
# SendGrid API Key (obtener en https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY=sk_test_your_sendgrid_key_here

# ===== RABBITMQ CONFIGURATION =====
# Host de RabbitMQ (en Docker, usar el nombre del servicio)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ===== DATABASE CONFIGURATION =====
# PostgreSQL connection details
DB_HOST=postgres
DB_PORT=5432
DB_NAME=emails_db
DB_USER=postgres
DB_PASSWORD=password

# ===== EMAIL SENDER CONFIGURATION =====
# Email y nombre del remitente
FROM_EMAIL=noreply@kuisiscore.com
FROM_NAME=KuisiScore

# ===== WORKER CONFIGURATION =====
# Cantidad máxima de reintentos para emails fallidos
MAX_RETRIES=3

# Prefetch count para RabbitMQ (mensajes a procesar simultáneamente)
QUEUE_PREFETCH_COUNT=1
